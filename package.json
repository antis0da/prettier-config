{
  "name": "@antisoda/prettier-config",
  "version": "1.2.3",
  "description": "A shareable Prettier preset configuration",
  "keywords": [
    "prettier",
    "prettier-config"
  ],
  "bugs": {
    "url": "https://github.com/antis0da/prettier-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/antis0da/prettier-config.git"
  },
  "license": "MIT",
  "author": "Andrea Di Marco <andrea.dimarco@me.com>",
  "sideEffects": false,
  "type": "module",
  "exports": [
    {
      "import": {
        "default": "./dist/prettier.config.mjs",
        "types": "./dist/prettier.config.d.ts"
      },
      "require": {
        "default": "./dist/prettier.config.cjs",
        "types": "./dist/prettier.config.d.ts"
      }
    }
  ],
  "main": "dist/prettier.config.cjs",
  "module": "dist/prettier.config.mjs",
  "types": "dist/prettier.config.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "rollup --config",
    "build:types": "tsc --project tsconfig.json",
    "clean": "git clean dist -X --force",
    "coverage": "vitest run --coverage",
    "format": "prettier . --write",
    "release": "changeset publish",
    "test": "vitest run",
    "version": "changeset version",
    "postversion": "npm i --package-lock-only"
  },
  "dependencies": {
    "prettier-plugin-css-order": "^2.1.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.5.10"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.2",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@vitest/coverage-v8": "^3.1.2",
    "lefthook": "^1.11.12",
    "prettier": "^3.5.3",
    "rollup": "^4.40.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "peerDependencies": {
    "prettier": ">= 3"
  },
  "publishConfig": {
    "access": "public"
  }
}
